# Google Gemini AI Studio API Key (Get a key at https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Automated Email Notifications (SMTP)
# To enable real email dispatch with PDF attachments:
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM="ECCBC Complaint Assistant <your_email@gmail.com>"
SMTP_USE_TLS=true

# Authentication (role-based access)
# Secret used to sign session tokens. Set a long random value in production.
# If unset locally, a random secret is generated in data/.auth_secret.
AUTH_SECRET=
# Show the three starter accounts on the login screen (set to false in production)
DEMO_ACCOUNTS=true
# Optional: override the starter account passwords (applied when data/users.json is first created)
# DEMO_CLIENT_PASSWORD=
# DEMO_EMPLOYEE_PASSWORD=
# DEMO_ADMIN_PASSWORD=

# Knowledge base: maximum size of a document uploaded from the admin screen (MB)
# KB_MAX_UPLOAD_MB=25
