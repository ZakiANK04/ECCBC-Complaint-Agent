# Environment variables & secrets (CRITICAL: NEVER COMMIT)
.env
.env.*
!.env.example

# Python
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.joblib
backend/data/models/*.joblib

# Vector store & local databases
backend/data/chroma_store/
*.sqlite3

# Accounts, session secret and SMTP overrides saved from the admin UI
backend/data/users.json
backend/data/.auth_secret
backend/config/smtp_config.json

# Generated PDFs and dynamic ticket storage
backend/data/tickets_pdf/*.pdf
backend/data/root_cause_reports/*.pdf

# Node.js & Frontend dependencies
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
.vercel

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
